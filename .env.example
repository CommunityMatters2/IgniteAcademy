# ── Required in production (Vercel → Project → Settings → Environment Variables) ──

# Auth signing secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Resend API key for invites, password resets, approvals, reminders and birthday emails
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend (e.g. ignite@yourdomain.org).
# Until then, onboarding@resend.dev only delivers to the Resend account owner.
EMAIL_FROM="IGNITE Academy <ignite@yourdomain.org>"

# Protects /api/cron/* (Vercel Cron sends it automatically when set)
CRON_SECRET=

# Public URL of the app (used in email links). Optional on Vercel production.
APP_URL=https://ignite.yourdomain.org

# ── Added automatically by Vercel integrations ──
# DATABASE_URL=            # Neon (Vercel Marketplace → Neon)
# BLOB_READ_WRITE_TOKEN=   # Vercel Blob (Storage → Blob, private store)

# ── Optional ──
# PROGRAM_TZ=America/New_York   # time zone for "today", birthdays and months

# ── Only for `npm run db:seed` (creates the first admin) ──
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
